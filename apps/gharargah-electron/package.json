{
  "name": "@gharargah/electron",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/main.mjs",
  "description": "Gharargah Mission Control desktop shell",
  "author": "Gharargah",
  "scripts": {
    "dev": "electron . --dev",
    "start": "electron .",
    "test": "node --test src/*.test.mjs",
    "pack:stage": "node ../../scripts/stage-electron-pack.mjs pack",
    "dist:dmg": "electron-builder --mac dmg --publish never",
    "postinstall": "node ./node_modules/electron/install.js"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "app.gharargah.desktop",
    "productName": "Gharargah",
    "copyright": "Copyright © Gharargah",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "pack",
        "to": "gharargah"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "title": "Gharargah",
      "artifactName": "Gharargah-${version}-${arch}.${ext}"
    },
    "electronLanguages": [
      "en"
    ]
  }
}
