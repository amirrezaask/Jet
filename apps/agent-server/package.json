{
  "name": "@gharargah/agent-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "gharargah-agent-server": "./src/bin.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/bin.ts",
    "start": "tsx src/bin.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@effect/platform": "0.97.1",
    "@effect/platform-node": "0.99.0",
    "@gharargah/agents": "workspace:*",
    "@gharargah/effect-acp": "workspace:*",
    "@gharargah/rpc": "workspace:*",
    "@opencode-ai/sdk": "^1.18.5",
    "effect": "3.22.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/ws": "^8.5.13",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
