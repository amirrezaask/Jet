{
  "name": "@gharargah/monaco",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./pending": {
      "types": "./src/pending-editor.ts",
      "default": "./src/pending-editor.ts"
    },
    "./environment": {
      "types": "./src/monaco-env.ts",
      "default": "./src/monaco-env.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-test-module-mocks --import tsx --test src/model-registry.test.ts src/pending-editor.test.ts src/language.test.ts src/utf16.test.ts src/diagnostics.test.ts src/theme.test.ts src/editor-shortcuts.test.ts"
  },
  "dependencies": {
    "@gharargah/shared": "workspace:*",
    "monaco-editor": "^0.52.2",
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-ws-jsonrpc": "^3.4.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "react-dom": "^19.1.0",
    "tsx": "^4.19.4",
    "typescript": "^7.0.2"
  }
}
