{
  "name": "@gharargah/node-host",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "postinstall": "node scripts/fix-node-pty-perms.mjs",
    "test": "tsx --test src/lsp-bridge.test.ts src/lsp-registry.test.ts src/search.test.ts src/shell-env.test.ts src/tasks.test.ts src/terminal.test.ts src/effect-terminal.test.ts"
  },
  "devDependencies": {
    "@gharargah/shared": "workspace:*",
    "@types/node": "^22.15.29",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ff-labs/fff-node": "^0.9.6",
    "@gharargah/rpc": "workspace:*",
    "@gharargah/shared": "workspace:*",
    "effect": "3.22.1",
    "node-pty": "^1.1.0",
    "ws": "^8.18.2"
  },
  "optionalDependencies": {
    "tsx": "^4.19.4"
  }
}
